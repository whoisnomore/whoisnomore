cat > ~/setup-nvim.sh << 'SCRIPT'
#!/usr/bin/env bash
set -e

echo "==> Installing packages"
sudo pacman -S --needed --noconfirm neovim git base-devel ripgrep fd \
  tree-sitter-cli rust-analyzer clangd lua-language-server

echo "==> Backing up and cleaning old state"
mkdir -p ~/.config/nvim
[ -f ~/.config/nvim/init.lua ] && cp ~/.config/nvim/init.lua ~/.config/nvim/init.lua.bak
rm -rf ~/.local/share/nvim ~/.local/state/nvim ~/.cache/nvim ~/.config/nvim/lazy-lock.json

echo "==> Writing ~/.config/nvim/init.lua"
cat > ~/.config/nvim/init.lua << 'EOF'
